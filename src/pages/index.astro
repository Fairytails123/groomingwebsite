---
// Legacy URL preserved: / . Ships LAST in the inside-out order (Stage 5).
// Source: grooming-image-archive/home/copy.md — section copy verbatim except the
// deviations logged in WEBSITE-PLAN.md (2026-07-16 Stage 5):
//
// 1. ⚠️ The old "Door-to-door service" section claimed pick-up "at no extra cost"
//    and the old Yoast description said "free door to door service". BANNED
//    (owner ruling: £2 per journey — stage3-checks enforces it). The section is
//    kept but its facts render from pricing.json `pickup`, including the
//    2026-07-16 evening ruling that bath & brush appointments are eligible too.
// 2. The old hero was a 2-slide carousel of the same slide, twice. It's a static
//    hero now — same three lines of copy, nothing hidden behind a click.
// 3. The old page embedded a live Google-reviews widget (4 review excerpts).
//    Static rebuild: the three site-authored testimonials are kept verbatim with
//    their real photos (Reg & Ter = Sarah's, Boo = Kadi's, Hugo = Laura's — the
//    named dogs in the quotes), plus a Google-reviews band rendered from
//    src/data/reviews-snapshot.json — the contract file the n8n
//    "Grooming Reviews Rotator" workflow overwrites weekly with fresh 5-star
//    excerpts. Never hardcode review text here. Owner ruling 2026-07-17: the
//    band is styled like the OLD SITE's widget — white background, avatar +
//    name + gold stars per card, clamped text with a More/Less expander — so
//    the reviews read as genuine Google reviews, not site copy.
// 4. Old-brand imagery (bubble composites, 200px bubble service thumbs, the
//    stock "dog on iPad" photo) is NOT carried over; cards reuse the rescued
//    real photos already shipped on the services cluster and gallery.
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import HillDivider from '../components/HillDivider.astro';
import HeroStage from '../components/HeroStage.astro';
import { business } from '../data/business';
import pricing from '../data/pricing.json';
import reviewsSnapshot from '../data/reviews-snapshot.json';

// Google-style avatar colours for the review cards — deterministic per author so
// the weekly rotation can't repaint a returning reviewer a different colour.
const AVATAR_COLORS = ['#d81b60', '#43a047', '#fb8c00', '#00897b', '#3949ab', '#8e24aa'];
const avatarColor = (name: string) =>
  AVATAR_COLORS[[...name].reduce((s, c) => s + c.charCodeAt(0), 0) % AVATAR_COLORS.length];

import teeth from '../assets/pages/services/teeth.jpg';
import massage from '../assets/pages/services/massage.jpg';
import puppy from '../assets/pages/services/puppy.jpg';
import matting from '../assets/pages/services/matting.jpg';
import handStripping from '../assets/pages/services/hand-stripping.jpg';
// ⚠️ Deliberately NOT services/pickup.jpg here: that image is a MAP whose legible
// labels are Bexhill, Battle and Rye — the three out-of-area towns the owner
// ruled we do NOT serve (stage3-checks bans them in text; a 286px image would
// advertise them in pixels). A freshly groomed dog ready to go home instead.
import dog06 from '../assets/pages/gallery/dog-06.jpg';
import regAndTer from '../assets/pages/home/reg-and-ter.png';
import boo from '../assets/pages/home/boo.png';
import hugo from '../assets/pages/home/hugo.png';
import groupOfDogs from '../assets/pages/services/group-of-dogs.png';
import dog01 from '../assets/pages/gallery/dog-01.jpg';
import dog16 from '../assets/pages/gallery/dog-16.jpg';
import dog17 from '../assets/pages/gallery/dog-17.jpg';
import dog19 from '../assets/pages/gallery/dog-19.jpg';

const { pickup, subscription, fullGroom } = pricing;

// Social share card (the old Yoast homepage had one too — bubble-3.png, which is
// banned old-brand imagery). JPEG derivative with explicit dimensions, same
// pattern as the blog pages; the homepage's own photos are too small (480px).
const ogJpeg = await getImage({ src: groupOfDogs, format: 'jpeg', width: 1200 });

// The five "at a glance" services from the old homepage — blurbs VERBATIM from
// the harvest. Photos are the rescued 300x300 originals used on /services/
// (small round thumbs, where 300px stays crisp at 2x).
const glance = [
  {
    name: 'Teeth cleaning',
    blurb: "Vibration- and sound-free ultrasonic teeth cleaning to help get your dog's gnashers white again.",
    image: teeth,
    alt: "A dog's teeth being cleaned",
    href: '/services/teeth-cleaning/',
  },
  {
    name: 'Doggy massage',
    blurb: 'Try a dog massage for your fur baby and notice the difference in coat, shine, matting and itchiness.',
    image: massage,
    alt: 'A dog having an oil massage',
    href: '/services/doggy-massage/',
  },
  {
    name: 'Puppy introduction',
    blurb: 'A familiarisation visit for your pup that includes an introduction to different grooming routines.',
    image: puppy,
    alt: 'A puppy meeting the grooming salon for the first time',
    href: '/services/',
  },
  {
    name: 'Dematting',
    blurb: "If your dog's coat gets matted and out of hand we are here to help make your dog comfortable again.",
    image: matting,
    alt: 'A matted coat being worked on',
    href: '/services/',
  },
  {
    name: 'Hand stripping',
    blurb: 'A traditional way of grooming the coat for wire coated breeds to reveal a neat, smooth texture and vibrant colour by removing excess topcoat.',
    image: handStripping,
    alt: 'A wire-coated terrier being hand stripped',
    href: '/services/full-groom-price-list/',
  },
];

// Hero polaroid strip — four gallery dogs (alt text follows the gallery's
// breeds-only-where-unmistakable rule; these four are all asserted there).
const heroDogs = [
  { src: dog01, alt: 'A chocolate Labradoodle standing on the grooming table after a full groom' },
  { src: dog16, alt: 'A white Bichon Frise with a rounded scissored coat' },
  { src: dog19, alt: 'A brown Cockapoo with its tongue out after a full groom' },
  { src: dog17, alt: 'An Afghan Hound with a bow in its topknot after a full groom' },
];

// Testimonials — quotes and attributions VERBATIM from the harvest. The photos
// are the dogs named in (or belonging to) each quote, from the old homepage.
const testimonials = [
  {
    quote: "I can't recommend The Fairy Tails Dog Grooming enough. My dogs get delivered back happy and smelling lovely!",
    name: 'Sarah, Hastings',
    image: regAndTer,
    alt: 'Two black curly-coated dogs sitting on the grass',
  },
  {
    quote: 'The only people I trust with Boo! Comes back so happy, looking and smelling amazing every time!',
    name: 'Kadi, Hastings',
    image: boo,
    alt: 'Boo, a brown and white spaniel wearing a bandana',
  },
  {
    quote: 'Lovely people, did such a great job on Hugo, he looks so handsome! I will definitely be going back!',
    name: 'Laura, Hastings',
    image: hugo,
    alt: 'Hugo, a long-coated cream dog wearing a bandana',
  },
];
---

<Base
  title="Home - The Fairy Tails Dog Grooming"
  description={`Your friendly Hastings dog groomers that care for your dog as you would yourself. Full grooms tailored to your dog's breed, from £${fullGroom.from}, in the heart of Hastings.`}
  path="/"
  ogImage={`${business.domain}${ogJpeg.src}`}
  ogImageWidth={Number(ogJpeg.attributes.width)}
  ogImageHeight={Number(ogJpeg.attributes.height)}
  ogImageType="image/jpeg"
>
  <article data-page="home">
    {/* ── HERO — FULL-BLEED ──────────────────────────────────────────────────────────────────
        Owner decision 2026-08-09: the grooming transformation spans the WHOLE moss band and the
        copy is laid over the composition's naturally empty top-left. It is no longer a
        two-column grid — that grid capped the stage at 594px at every desktop width, which was
        right for the old single-puppy artwork but starves the new four-dog pack. Full-bleed
        gives the stage 775–1682px, so the pack renders 652–1416px wide instead of 500px.

        The TRACK still only exists at lg+: there the hero pins for 240vh and the pack is groomed
        as you scroll, with the headline and CTAs held on screen the whole way. Below lg the
        track collapses, nothing sticks, the copy sits ABOVE the stage (text over four dogs is
        unreadable) and the stage plays through once when it scrolls into view — most of this
        salon's customers arrive on a phone (CLAUDE.md), and pinning them for two extra screens
        before any content is a conversion cost the animation has not earned.

        Copy is unchanged and verbatim, and is FIRST in the DOM: that is the reading order, the
        mobile visual order, and the H1 is the LCP element. The desktop overlay is done with
        z-index, NEVER with source order. */}
    <div class="relative bg-moss-900 lg:h-[240vh]" data-hero-track>
      <header
        class="relative overflow-hidden pb-16 pt-32 sm:pb-24 sm:pt-44 lg:sticky lg:top-0 lg:h-screen lg:pb-0 lg:pt-0"
        data-hero-sticky
      >
        <div class="mx-auto w-full max-w-6xl px-4" data-hero-copy>
          {/* Two blocks, because the pack is a STAIRCASE not a box — see the style block. The
              eyebrow + H1 sit against the wide shelf; the subcopy + CTAs drop into the narrow
              one under the shorter dogs on the left. */}
          <div data-hero-head>
            <p class="eyebrow text-honey-300" data-hero-eyebrow>Hastings dog groomers</p>
            <h1
              class="mt-4 max-w-2xl font-display text-4xl font-bold leading-tight text-cream-50 sm:text-6xl lg:mt-0"
            >
              Caring for your best friend
            </h1>
          </div>
          <div data-hero-lower>
            <p class="mt-5 max-w-xl text-lg text-cream-200 lg:mt-0" data-hero-sub>
              Dog grooming to suit your needs — every groom tailored to your dog's breed, in the
              heart of Hastings.
            </p>
            <div class="mt-8 flex flex-wrap items-center gap-4 lg:mt-0" data-hero-cta>
              <a href={business.booking.jotform} class="btn btn-honey">Book Appointment</a>
              <a href="/services/full-groom-price-list/" class="btn btn-ghost-light">
                See the price list
              </a>
            </div>
          </div>
          {/* No ReviewsBadge here by owner ruling (2026-07-17): the hero carries copy and
              CTAs only. The badge still renders in the footer on every page, and the
              "Fresh from Google" section below carries the review proof on this one.
              Unchanged by the full-bleed restructure. */}
        </div>

        <div data-hero-media>
          <HeroStage />
          {/* No scroll cue here by owner ruling (2026-07-17): the transformation announces
              itself; a caption under the stage was one more thing popping out of the band. */}
        </div>
      </header>
    </div>
    <HillDivider class="text-moss-900" flip />

    {/* Fresh off the table — these four were loading="eager" when they sat directly under a
        one-screen hero. The hero now owns a 240vh scroll track on desktop, so the strip is 2.4
        screens below the fold and eager-loading ~85KB of it ahead of the fonts the headline is
        waiting on is simply wrong now. Lazy defers them out of the load without deferring
        anything a visitor can actually see. */}
    <section class="mx-auto max-w-6xl px-4 pt-10 sm:pt-14">
      <div class="grid grid-cols-2 gap-4 sm:grid-cols-4">
        {
          heroDogs.map((d, i) => (
            <figure class="polaroid" style={`rotate: ${(i % 4) - 1.5}deg`}>
              <Image
                src={d.src}
                alt={d.alt}
                class="aspect-square w-full object-cover"
                widths={[240, 480]}
                sizes="(min-width: 1024px) 260px, (min-width: 640px) 22vw, 44vw"
                loading="lazy"
              />
            </figure>
          ))
        }
      </div>
      <p class="mt-6 text-center">
        <a
          href="/gallery/"
          class="inline-flex min-h-11 items-center font-bold text-moss-700 underline decoration-honey-500 decoration-2 underline-offset-4 hover:text-moss-800"
        >
          Fresh off the table — see the gallery
        </a>
      </p>
    </section>

    <!-- Who we are -->
    <section class="mx-auto max-w-3xl px-4 pt-16 text-center">
      <p class="eyebrow text-honey-700">Who we are</p>
      <h2 class="mt-3 font-display text-3xl font-bold text-moss-900 sm:text-4xl">
        Happy dogs are what we are all about
      </h2>
      <p class="mx-auto mt-4 max-w-xl leading-relaxed text-bark-700">
        We offer a professional dog grooming service that matches your dog grooming preference
        with a happy dog grooming experience.
      </p>
      <div class="mt-7 flex flex-wrap items-center justify-center gap-4">
        <a href="/who-we-are/" class="btn btn-moss">Know more</a>
      </div>
    </section>

    <!-- Specialist services at a glance -->
    <section class="mx-auto max-w-6xl px-4 pt-16">
      <div class="mx-auto max-w-2xl text-center">
        <p class="eyebrow text-honey-700">At a glance</p>
        <h2 class="mt-3 font-display text-3xl font-bold text-moss-900">
          Some of our specialist services
        </h2>
        <p class="mt-4 leading-relaxed text-bark-700">
          We offer the full range of dog grooming services, plus we will do our utmost to
          accommodate your specific needs on request.
        </p>
      </div>

      <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          glance.map((s) => (
            <article class="flex gap-4 rounded-2xl border-2 border-cream-200 p-5">
              <Image
                src={s.image}
                alt={s.alt}
                class="h-16 w-16 shrink-0 rounded-full object-cover"
                widths={[64, 128]}
                sizes="64px"
                loading="lazy"
              />
              <div>
                <h3 class="font-display text-lg font-bold leading-tight text-moss-900">{s.name}</h3>
                <p class="mt-1.5 text-sm leading-relaxed text-bark-700">{s.blurb}</p>
                <a
                  href={s.href}
                  class="mt-1 inline-flex min-h-11 items-center text-sm font-bold text-moss-700 underline decoration-honey-500 decoration-2 underline-offset-4 hover:text-moss-800"
                >
                  Find out more<span class="sr-only"> about {s.name.toLowerCase()}</span>
                </a>
              </div>
            </article>
          ))
        }
        <div class="flex items-center justify-center rounded-2xl bg-cream-100 p-5">
          <a href="/services/" class="btn btn-moss">See our full range of services</a>
        </div>
      </div>
    </section>

    <!-- Door-to-door service (facts single-sourced from pricing.json `pickup`) -->
    <section class="mx-auto max-w-6xl px-4 pt-16">
      <div class="rounded-3xl bg-cream-100 px-6 py-10 sm:px-10 sm:py-12">
        <div class="grid items-center gap-10 md:grid-cols-2">
          <div>
            <p class="eyebrow text-honey-700">Door-to-door service</p>
            <h2 class="mt-3 font-display text-3xl font-bold text-moss-900">
              Local pick ups and drop offs
            </h2>
            <p class="mt-4 leading-relaxed text-bark-700">
              Your time is better spent doing the things you love, so don't wait around and let us
              take the hassle out of dog grooming for your fur baby. We'll pick up and drop off at
              a time which suits you, from your home or office — £{pickup.journeyPrice} per journey
              (£{pickup.roundTripPrice} for the round trip) across {pickup.areas}, for {pickup.eligible}.
            </p>
            <p class="mt-3 text-sm text-bark-600">
              Collection and drop-off time windows are on the
              <a
                href="/services/frequently-asked-questions/"
                class="font-bold text-moss-700 underline decoration-honey-500 decoration-2 underline-offset-4 hover:text-moss-800"
              >FAQ page</a>.
            </p>
            <div class="mt-6">
              <a href={business.booking.jotform} class="btn btn-honey">Book Appointment</a>
            </div>
          </div>
          <figure class="polaroid mx-auto w-full max-w-sm">
            <Image
              src={dog06}
              alt="A freshly groomed Shih Tzu in an orange bandana, ready for the trip home"
              class="aspect-square w-full object-cover"
              widths={[240, 480]}
              sizes="(min-width: 768px) 384px, 90vw"
              loading="lazy"
            />
          </figure>
        </div>
      </div>
    </section>

    <!-- Subscription (mirrors the /services/ band; facts from pricing.json) -->
    <section class="mx-auto max-w-6xl px-4 pt-16">
      <div class="rounded-3xl bg-moss-900 px-6 py-10 text-cream-50 sm:px-10 sm:py-12">
        <div class="grid gap-8 md:grid-cols-2 md:items-center">
          <div>
            <p class="eyebrow text-honey-300">Dog grooming subscription</p>
            <h2 class="mt-3 font-display text-3xl font-bold sm:text-4xl">
              £{subscription.price} a month, per dog
            </h2>
            <p class="mt-4 text-cream-200">{subscription.availability}</p>
            <div class="mt-7 flex flex-wrap items-center gap-4">
              <a href={business.subscription.stripeUrl} class="btn btn-honey">
                Set up Grooming Subscription
              </a>
              <p class="text-sm text-cream-200">
                £{subscription.price} {subscription.unit}<br />
                {subscription.minTermMonths}-month minimum term
              </p>
            </div>
          </div>
          <ul class="grid gap-2.5 text-cream-100">
            {subscription.includes.map((i) => <li class="paw-bullet flex items-start text-sm">{i}</li>)}
          </ul>
        </div>
      </div>
    </section>

    <!-- Satisfied customers -->
    <section class="mx-auto max-w-6xl px-4 pt-16">
      <div class="mx-auto max-w-2xl text-center">
        <p class="eyebrow text-honey-700">Satisfied customers</p>
        <h2 class="mt-3 font-display text-3xl font-bold text-moss-900">What our customers say</h2>
        <p class="mt-4 leading-relaxed text-bark-700">
          We are lucky to receive many compliments on our work and here is what some of our
          customers have to say about our services.
        </p>
      </div>

      <div class="mt-10 grid gap-7 sm:grid-cols-3">
        {
          testimonials.map((t) => (
            <figure class="flex flex-col rounded-2xl bg-cream-100 p-6">
              <blockquote class="flex-1 leading-relaxed text-bark-700">
                &ldquo;{t.quote}&rdquo;
              </blockquote>
              <figcaption class="mt-5 flex items-center gap-3 border-t border-cream-200 pt-4">
                <Image
                  src={t.image}
                  alt={t.alt}
                  class="h-12 w-12 rounded-full object-cover"
                  widths={[48, 96]}
                  sizes="48px"
                  loading="lazy"
                />
                <span class="font-bold text-moss-900">{t.name}</span>
              </figcaption>
            </figure>
          ))
        }
      </div>

    </section>

    <!-- Google reviews — owner ruling 2026-07-17: styled like the OLD SITE's embedded widget
         (white band, avatar + name + gold stars, clamped text with More) so the reviews read as
         genuine Google reviews. Content still comes verbatim from reviews-snapshot.json (the
         n8n rotator's contract file — never hardcode review text). The More/Less expander is
         JS-applied: with JS off the full text is simply visible and no dead control renders
         (same progressive-enhancement rule as the price-list filter). -->
    <section class="mt-16 bg-white py-14 sm:py-16" aria-labelledby="greviews-title">
      <div class="mx-auto max-w-6xl px-4">
        <p class="eyebrow text-honey-700">Reviews from Google</p>
        <h2 id="greviews-title" class="mt-3 font-display text-3xl font-bold text-neutral-900">
          {business.name}
        </h2>
        <p class="mt-1 text-sm text-neutral-600">
          {business.address.line1}, {business.address.town}
        </p>
        {/* The aggregate score block ("4.9 ★★★★★ · 63 reviews") was REMOVED by owner ruling
            (2026-08-09): the headline count read as thin next to the quality of the reviews
            themselves. The individual review cards below carry the proof instead, which is the
            stronger signal anyway. Do NOT reinstate it without asking.
            Safe to remove: nothing in this repo emits AggregateRating structured data, so there
            is no schema that now claims a rating the page does not show (which Google treats as
            a structured-data violation). If an aggregate rating is ever marked up, it MUST be
            visible on the page again. business.reviews.rating/count are still live — the footer
            ReviewsBadge renders them on every page, this one included. */}

        {/* Carousel (owner ruling 2026-08-09: the cards should move left and right).
            Native scroll-snap does the work, so it swipes on a phone and trackpad-scrolls on a
            desktop with NO JavaScript — the arrows are pure enhancement and stay hidden until JS
            proves the strip actually overflows (same progressive-enhancement rule as the More
            expanders and the price-list filter: never render a dead control).
            The card widths deliberately leave the next card PEEKING (86% on a phone, ~31% on
            desktop). That peek, not the arrows, is what tells a thumb it can swipe — arrows are
            hidden below sm because nobody taps a carousel arrow on a phone.
            The strip scrolls inside its OWN overflow-x container, which is what keeps the body
            from scrolling sideways at 390px (the mobile gate's hard rule). */}
        <div class="relative mt-8">
          <button
            type="button"
            data-rev-prev
            hidden
            aria-label="Previous reviews"
            class="absolute left-0 top-1/2 z-10 hidden h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full bg-white text-neutral-700 shadow-md ring-1 ring-neutral-200 transition hover:bg-neutral-50 disabled:pointer-events-none disabled:opacity-0 sm:flex"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18 9 12l6-6" /></svg>
          </button>
          <button
            type="button"
            data-rev-next
            hidden
            aria-label="More reviews"
            class="absolute right-0 top-1/2 z-10 hidden h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full bg-white text-neutral-700 shadow-md ring-1 ring-neutral-200 transition hover:bg-neutral-50 disabled:pointer-events-none disabled:opacity-0 sm:flex"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
          </button>

          {/* tabindex+role: a scrollable region must be reachable and operable by keyboard
              (WCAG 2.1.1). Without them the arrows are the only way through, and they are
              mouse-only by design. */}
          <div
            data-rev-scroller
            role="region"
            aria-label="Reviews from Google"
            tabindex="0"
            class="ft-rev-scroll flex snap-x snap-mandatory gap-6 overflow-x-auto scroll-smooth pb-2"
          >
          {/* Card widths are chosen so the NEXT card always peeks by a visible amount, never a
              sliver: at lg, 3 cards (3×28% + 2 gaps ≈ 88%) leave ~130px of the fourth showing.
              31% was tried first and left a 31px edge that read as a clipping bug rather than an
              invitation to swipe. (This comment lives OUTSIDE the .map() on purpose — an Astro
              expression beside the <figure> makes two root nodes and fails the build.) */}
          {
            reviewsSnapshot.reviews.map((r, i) => (
              <figure class="flex shrink-0 basis-[82%] snap-start flex-col sm:basis-[44%] lg:basis-[28%]">
                <figcaption class="flex items-center gap-3">
                  <span
                    class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full text-base font-bold text-white"
                    style={`background:${avatarColor(r.author)}`}
                    aria-hidden="true"
                  >
                    {r.author.trim().charAt(0).toUpperCase()}
                  </span>
                  <span class="min-w-0">
                    <span class="block truncate font-bold text-neutral-900">{r.author}</span>
                    <span class="text-sm tracking-wide text-[#fbbc05]" aria-hidden="true">
                      {'★'.repeat(r.rating)}
                    </span>
                    <span class="sr-only">{r.rating} out of 5 stars</span>
                  </span>
                </figcaption>
                <blockquote class="mt-3 flex-1 rounded-xl border border-neutral-200 bg-white p-4 shadow-sm">
                  <p id={`rev-text-${i}`} data-rev-text class="text-sm leading-relaxed text-neutral-700">
                    {r.text}
                  </p>
                  {/* min-h/w-11 = the 44px tap target (mobile gate measures BUTTONS with no
                      inline-text exemption); the negative margins hand the padding back so the
                      card keeps its rhythm. Hidden until the clamp JS proves there is more to
                      show — a short review never gets a dead More. */}
                  <button
                    type="button"
                    data-rev-more
                    aria-expanded="false"
                    aria-controls={`rev-text-${i}`}
                    hidden
                    class="-mb-3 -ml-2 inline-flex min-h-11 min-w-11 items-center px-2 text-sm font-bold text-[#1a73e8] hover:underline"
                  >
                    More
                  </button>
                </blockquote>
              </figure>
            ))
          }
          </div>
        </div>

        <div class="mt-8 flex flex-col items-start justify-between gap-2 sm:flex-row sm:items-center">
          <a
            href={business.reviews.readUrl}
            class="inline-flex min-h-11 items-center gap-2.5 font-bold text-[#1a73e8] hover:underline"
          >
            <svg width="20" height="20" viewBox="0 0 48 48" aria-hidden="true">
              <path fill="#ffc107" d="M43.6 20.1H42V20H24v8h11.3C33.7 32.7 29.2 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.9 1.2 8 3l5.7-5.7C34.3 6.1 29.4 4 24 4 13 4 4 13 4 24s9 20 20 20 20-9 20-20c0-1.3-.1-2.6-.4-3.9z"/>
              <path fill="#ff3d00" d="m6.3 14.7 6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.9 1.2 8 3l5.7-5.7C34.3 6.1 29.4 4 24 4 16.3 4 9.7 8.3 6.3 14.7z"/>
              <path fill="#4caf50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 35.1 26.7 36 24 36c-5.2 0-9.6-3.3-11.3-8l-6.5 5C9.5 39.6 16.2 44 24 44z"/>
              <path fill="#1976d2" d="M43.6 20.1H42V20H24v8h11.3c-.8 2.2-2.2 4.2-4.1 5.6l6.2 5.2C41.4 35.2 44 30 44 24c0-1.3-.1-2.6-.4-3.9z"/>
            </svg>
            See all our reviews on Google
          </a>
          {/* The "Verbatim excerpts … refreshed weekly" caption was REMOVED by owner ruling
              (2026-08-09). The reviews are still exactly that — verbatim, rotator-fed — the
              owner simply does not want the mechanism narrated to customers. Don't reinstate. */}
        </div>
      </div>
    </section>

    <!-- Final CTA -->
    <section class="mx-auto max-w-3xl px-4 pb-24 pt-16 text-center">
      <div class="rounded-3xl bg-cream-100 px-6 py-12">
        <h2 class="font-display text-3xl font-bold text-moss-900">Ready when you are</h2>
        <p class="mx-auto mt-4 max-w-md leading-relaxed text-bark-700">
          Book your dog's groom online, or get in touch and we'll help you work out what's right
          for their coat.
        </p>
        <div class="mt-7 flex flex-wrap items-center justify-center gap-4">
          <a href={business.booking.jotform} class="btn btn-honey">Book Appointment</a>
          <a href="/contact/" class="btn btn-moss">Get in touch</a>
        </div>
      </div>
    </section>
  </article>
</Base>

<style>
  /* The polaroid tilt is decorative (same rule as /gallery/). */
  @media (prefers-reduced-motion: reduce) {
    .polaroid {
      rotate: 0deg !important;
    }
  }

  /* Review-card clamp — applied by JS only, so with JS off the full text is simply visible
     and no dead More button renders. Hand-prefixed: this repo has no autoprefixer. */
  [data-rev-text].rev-clamp {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 4;
    line-clamp: 4;
    overflow: hidden;
  }

  /* The review strip scrolls, but its scrollbar is noise under a row of white cards — the
     peeking next card and the arrows carry the affordance instead. Keyboard and wheel scrolling
     are untouched; only the bar is hidden. */
  .ft-rev-scroll {
    scrollbar-width: none;
    -ms-overflow-style: none;
    /* ⚠ Load-bearing, and NOT a cosmetic hint. Without it this strip's off-screen cards leak
       into `document.documentElement.scrollWidth` (measured: 1124px at a 390px viewport) even
       though `overflow-x: auto` clips them correctly and the page provably cannot scroll
       sideways — window.scrollX stays 0 when you try. Setting `overflow: hidden` does NOT
       suppress the inflated number; only paint containment does.
       That matters because scripts/mobile-check.mjs:93 gates on exactly
       `de.scrollWidth > vw + 1`, so the phantom width fails the mobile gate outright. The fix
       belongs here — making the DOM's reported width honest — rather than in the gate, which is
       right to be strict. Safe: the arrows live OUTSIDE this element, so nothing inside needs to
       escape its paint box. */
    contain: paint;
  }
  .ft-rev-scroll::-webkit-scrollbar {
    display: none;
  }
  /* A focused scroll region must still show where focus is (WCAG 2.4.7) — the default outline
     is clipped by overflow, so give it an offset ring that sits outside the scroll box. */
  .ft-rev-scroll:focus-visible {
    outline: 2px solid var(--color-moss-500);
    outline-offset: 4px;
  }
  /* scroll-smooth is motion: honour the OS setting, or an arrow press becomes a lurch for
     exactly the people who asked it not to. */
  @media (prefers-reduced-motion: reduce) {
    .ft-rev-scroll {
      scroll-behavior: auto;
    }
  }

  /* ══ THE FULL-BLEED HERO ══════════════════════════════════════════════════════════════════
     Every constant here is MEASURED off the handoff's artwork. The pack (dogs-group.png,
     963×497, drawn at stage 30,256,640×330) is a STAIRCASE, not a box: its left end tops out at
     stage y≈372 while the tallest dog on the right reaches y=257. Sampling its alpha per column
     gives the depth a left-anchored copy column may reach:

         copy runs to stage x ≤ 190  →  clear to y 371.5  (59.9% of stage height)
         copy runs to stage x ≤ 360  →  clear to y 311.8  (50.3%)
         copy runs to stage x ≤ 520  →  clear to y 278.6  (44.9%)
         copy runs to stage x ≤ 570  →  clear to y 256.7  (41.4%)
         fairy occupies stage x 580..750, y 10..233

     So the copy is two blocks against two shelves: eyebrow + H1 use the wide one (x ≤ 520),
     subcopy + CTAs drop into the narrow one (x ≤ 360). Verified at 14 viewports; the tightest
     clearance anywhere is 26.5 stage units (27px) at 1440×700. That number is measured against
     the SILHOUETTE, not a bounding box — it is a CTA sitting 27px above the tip of an ear. If
     the subcopy ever grows or a third CTA appears, this is what breaks first: re-measure, don't
     eyeball.

     ⚠️ The STARS are deliberately NOT in this budget. Their flight path is a diagonal across the
     whole top-left (painted-ink bbox stage x 1.7..697.7, y 98..392); dodging it would leave the
     copy ~100 stage units wide. They pass BEHIND the copy instead — legibility is a hard
     requirement, sparkle is decoration, and a 19px glowing star crossing a cream glyph destroys
     the letterform for several frames. */

  /* = the fixed site header's measured height: py-3 (12+12) + the h-11 logo (44) = 68px.
     .is-scrolled only scales the logo with a transform, so this never changes at runtime. */
  [data-hero-track] {
    --ft-hero-top: 4.25rem;
  }

  /* Below lg the stage is edge-to-edge (the composition carries its own 4% left / 1.3% right
     margins), but capped by HEIGHT so a landscape phone does not get a 688px stage on a 390px
     screen: 78svh × 760/620 = 95.61svh, written as a WIDTH so the aspect-ratio box still
     produces the height. svh, not vh — it must not move with the URL bar. */
  [data-hero-media] {
    margin-top: 2rem;
    width: min(100%, 95.61svh);
    margin-inline: auto;
  }

  @media (min-width: 64rem) {
    /* --ft-stage-h is THE single source of every hero proportion: the composition's rendered
       height. It is the sticky's content box (100vh minus the header clearance) unless the band
       is too narrow to hold a 760:620 box, in which case the WIDTH is the limit
       (620/760 = 0.815789). Drive ONE dimension and let aspect-ratio produce the other —
       `max-width` would clamp the width while leaving the height at 100%, violating the ratio
       and squashing every percentage-positioned child inside HeroStage with it.

       ⚠️ THE 64rem THIRD TERM IS AN ASSET CEILING, not a design choice. dogs-group.png is only
       963px wide at source and renders at 1.032 × --ft-stage-h, so 1:1 parity is at a stage
       height of 933px. Uncapped, a 2560×1440 monitor asks for a 1372px stage height = a 1416px
       pack = a 47% upscale of a photograph, which reads soft. Capping at 64rem (1024px) holds
       the worst case to ~1.10×, which is invisible, and simply centres the composition in the
       band on very tall screens. Raise this ONLY if a higher-resolution original of the pack
       photo is supplied — then re-measure parity and move both numbers together. */
    [data-hero-sticky] {
      --ft-stage-h: min(calc(100vh - var(--ft-hero-top)), 81.5789vw, 64rem);
      display: grid;
      grid-template-areas: 'stack';
      padding: var(--ft-hero-top) 0 0;
    }
    /* Exact version where container queries exist: cqh/cqw are the sticky's own content box, so
       this tracks the real geometry instead of re-deriving it, and is scrollbar-proof. The vh
       line above is the identical fallback — both measured green at all 14 viewports, so this
       is a refinement, not a dependency.
       ⚠️ container-type MUST stay inside this media query: it implies contain:size, and below lg
       the sticky is auto-height, so leaking it out collapses the whole hero to zero height. */
    @supports (container-type: size) {
      [data-hero-sticky] {
        container-type: size;
        --ft-stage-h: min(100cqh, 81.5789cqw, 64rem);
      }
    }

    [data-hero-copy],
    [data-hero-media] {
      grid-area: stack;
    }

    /* ⚠️ z-index is explicit on BOTH layers and is load-bearing. HeroStage's own children carry
       z-index up to 6 (.ft-fairy). `position: relative` alone does NOT create a stacking
       context, so without `z-index: 0` here the fairy and the particle layer compete directly
       with the copy and paint OVER the headline. */
    [data-hero-media] {
      position: relative;
      z-index: 0;
      justify-self: center;
      align-self: center;
      margin: 0;
      height: var(--ft-stage-h);
      width: auto;
      aspect-ratio: 760 / 620;
    }
    /* The copy box IS the stage box (same height, same centring), so its padding and type are
       percentages OF THE COMPOSITION — the same idiom HeroStage uses internally. */
    [data-hero-copy] {
      position: relative;
      z-index: 10;
      align-self: center;
      height: var(--ft-stage-h);
      padding-top: calc(0.035 * var(--ft-stage-h));
    }

    /* The two shelves. Percentages are of the max-w-6xl container — which is also what puts the
       H1's left edge on exactly the same line as every section below. Do NOT re-derive this
       from 100vw: that includes the scrollbar and max-w-6xl does not, so it misaligns by ~7px
       on real Windows Chrome. */
    [data-hero-head] {
      max-width: min(42rem, 64%);
    }
    [data-hero-lower] {
      max-width: min(31rem, 44%);
    }

    /* Type scales with the COMPOSITION, not the page — the handoff's own clamp(40px,4.5vw,64px)
       idea re-anchored to HEIGHT because the stage is height-driven. Without it the block is a
       fixed ~485px and lands ON the dogs at 1366×768 and 1280×800 (measured: 134px and 119px of
       overlap). Narrowing the column makes it WORSE, not better — the CTA row wraps to two rows
       (238px vs 142px). */
    [data-hero-eyebrow] {
      font-size: clamp(0.7rem, calc(0.016 * var(--ft-stage-h)), 0.8rem);
    }
    [data-hero-copy] h1 {
      font-size: clamp(2rem, calc(0.072 * var(--ft-stage-h)), 4rem);
      margin-top: clamp(0.5rem, calc(0.018 * var(--ft-stage-h)), 1rem);
      /* em, not px — and 10.5 is measured, not rounded. The headline sets on ONE line at 12.92em
         in Fraunces, 13.32em in Georgia, but only 11.17em in the swap fallback Windows Chrome
         actually uses (ui-serif → Times New Roman). Any cap between those gives one line before
         the font lands and two after: a layout shift on the LCP element on every cold load.
         10.5em is below all three, so the break is identical in every font. */
      max-width: 10.5em;
      text-wrap: balance;
    }
    [data-hero-sub] {
      font-size: clamp(0.9375rem, calc(0.022 * var(--ft-stage-h)), 1.125rem);
      margin-top: clamp(0.625rem, calc(0.024 * var(--ft-stage-h)), 1.25rem);
      max-width: none; /* the shelf on [data-hero-lower] governs here, not max-w-xl */
    }
    [data-hero-cta] {
      margin-top: clamp(0.875rem, calc(0.033 * var(--ft-stage-h)), 2rem);
    }
    [data-hero-copy] .btn {
      /* The clamp alone drops the button to 42.1px at 1440×700 — under the 44px tap floor. */
      min-height: 2.75rem;
      padding-block: clamp(0.55rem, calc(0.0155 * var(--ft-stage-h)), 0.875rem);
      font-size: clamp(0.9375rem, calc(0.019 * var(--ft-stage-h)), 1rem);
    }
  }

  /* Reduced motion: there is no scrub, so the 240vh track is pure dead scroll — 1.5 screens of
     a pinned, static hero before any content, which reads as a stuck page. The track's whole
     justification is giving the animation room to play; when the visitor's OS has switched the
     animation off, only the cost remains. Same principle the mobile layout already applies.
     ⚠️ height:auto does NOT collapse the hero itself — the sticky keeps lg:h-screen, so the
     full-bleed composition still gets its whole screen and the copy stays laid over it; only
     the 1.4 screens of dead scroll below it go. Never add `lg:h-auto` here: that would make
     --ft-stage-h resolve against the copy's own height and squash the composition. */
  @media (prefers-reduced-motion: reduce) {
    [data-hero-track] {
      height: auto;
    }
  }
</style>

<script>
  // Google-review More/Less expanders. ⚠ Astro dedupes this module to at most ONE run per
  // session, even across ClientRouter navigations (the same trap HeroStage.astro documents) —
  // so init re-runs per page via astro:page-load and is idempotent per element.
  function initReviewExpanders() {
    document.querySelectorAll<HTMLParagraphElement>('[data-rev-text]').forEach((txt) => {
      if (txt.dataset.revInit) return;
      txt.dataset.revInit = '1';
      const btn = txt.parentElement?.querySelector<HTMLButtonElement>('[data-rev-more]');
      if (!btn) return;
      txt.classList.add('rev-clamp');
      // Offer More only when the clamp actually hides something — a short review (like the
      // reference widget's second card) gets no dead control.
      if (txt.scrollHeight <= txt.clientHeight + 1) {
        txt.classList.remove('rev-clamp');
        return;
      }
      btn.hidden = false;
      btn.addEventListener('click', () => {
        const expanded = btn.getAttribute('aria-expanded') === 'true';
        btn.setAttribute('aria-expanded', String(!expanded));
        txt.classList.toggle('rev-clamp', expanded);
        btn.textContent = expanded ? 'More' : 'Less';
      });
    });
  }
  // Review carousel arrows. The strip is already fully usable without this (native scroll-snap
  // + swipe + keyboard); JS only adds the two buttons, and only when the strip really overflows.
  function initReviewCarousel() {
    const scroller = document.querySelector<HTMLElement>('[data-rev-scroller]');
    if (!scroller || scroller.dataset.revCarousel) return;
    const prev = document.querySelector<HTMLButtonElement>('[data-rev-prev]');
    const next = document.querySelector<HTMLButtonElement>('[data-rev-next]');
    if (!prev || !next) return;
    scroller.dataset.revCarousel = '1';

    // Step by one whole card (card width + the gap) rather than a fixed pixel count, so the
    // snap points and the arrows agree at every breakpoint.
    const step = () => {
      const card = scroller.firstElementChild as HTMLElement | null;
      if (!card) return scroller.clientWidth;
      const gap = parseFloat(getComputedStyle(scroller).columnGap || '0') || 0;
      return card.getBoundingClientRect().width + gap;
    };

    // 1px of slack: fractional layout widths mean scrollLeft rarely hits the exact maximum, and
    // without it the "next" arrow stays enabled forever at the right-hand end.
    const sync = () => {
      const max = scroller.scrollWidth - scroller.clientWidth;
      const overflows = max > 1;
      prev.hidden = !overflows;
      next.hidden = !overflows;
      if (!overflows) return;
      prev.disabled = scroller.scrollLeft <= 1;
      next.disabled = scroller.scrollLeft >= max - 1;
    };

    prev.addEventListener('click', () => scroller.scrollBy({ left: -step(), behavior: 'smooth' }));
    next.addEventListener('click', () => scroller.scrollBy({ left: step(), behavior: 'smooth' }));
    scroller.addEventListener('scroll', sync, { passive: true });
    // Expanding a review changes the strip's height, not its width — but a breakpoint change or
    // a font swap changes both, so observe rather than measure once.
    new ResizeObserver(sync).observe(scroller);
    sync();
  }

  initReviewExpanders();
  initReviewCarousel();
  document.addEventListener('astro:page-load', () => {
    initReviewExpanders();
    initReviewCarousel();
  });
</script>
